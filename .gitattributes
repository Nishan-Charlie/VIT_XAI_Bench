# Normalise line endings so the repo is identical on Windows and Linux.
* text=auto eol=lf
*.sh   text eol=lf
*.bat  text eol=crlf

# Binary assets — never diff or merge these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.mp4  binary
*.pt   binary
*.pth  binary

# Generated data: keep out of language stats and collapse in PR diffs.
website/public/data/*.json linguist-generated=true
results/processed/*.json   linguist-generated=true
figures/**                 linguist-documentation
