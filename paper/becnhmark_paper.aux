\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Rankings do not transfer.} Pointing Game rank of the ten methods applicable to every backbone, across the architectural evolution from CNN to linear attention. Grad-CAM (bold orange) holds rank 1 on the CNN, isotropic, and hierarchical backbones, then falls to last place on the linear-attention EfficientViT-B2; Grad-CAM++ swings between rank 2 and rank 10 depending on the backbone. Ranks use the bounding-box Pointing Game; under the dense-mask EBPG (Table~\ref {tab:ebpg}) the ordering shifts further, lifting VarGrad and lowering Grad-CAM.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:rankflip}{{5}{9}{\textbf {Rankings do not transfer.} Pointing Game rank of the ten methods applicable to every backbone, across the architectural evolution from CNN to linear attention. Grad-CAM (bold orange) holds rank 1 on the CNN, isotropic, and hierarchical backbones, then falls to last place on the linear-attention EfficientViT-B2; Grad-CAM++ swings between rank 2 and rank 10 depending on the backbone. Ranks use the bounding-box Pointing Game; under the dense-mask EBPG (Table~\ref {tab:ebpg}) the ordering shifts further, lifting VarGrad and lowering Grad-CAM}{figure.caption.9}{}}
