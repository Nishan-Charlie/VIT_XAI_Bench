# ── Secrets — never commit ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/

# ── Datasets and model weights (fetched, never committed) ─────────────
data/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# ── Benchmark run outputs ─────────────────────────────────────────────
# results/raw and results/processed ARE tracked: they are the published
# result set the figures and website are built from. Everything else a run
# writes (per-image rows, saliency dumps, scratch runs) is not.
results/*
!results/raw/
!results/processed/
!results/README.md
results/raw/*
!results/raw/benchmark_runs.csv
!results/raw/computational_cost.csv
results/**/results.json
results/**/results.csv

# ── Working files ─────────────────────────────────────────────────────
scratch/
archive/
out.txt
*.ipynb_checkpoints
.DS_Store
Thumbs.db

# ── Editor / agent notes ──────────────────────────────────────────────
AGENTS.md
CLAUDE.md
NOTES_next.md
RESEARCH_PLAN.md
.claude/

# Notebooks are dev artifacts, not part of the published benchmark
*.ipynb

# NEUCOM revision outputs (per-image CSVs and analysis; the map cache is regenerable)
!results/revision_neucom/
results/revision_neucom/maps/
!results/revision_vit_native/
!results/revision_gradshap_fill/

# The five-metric grid that records.json is built from (500 images, every backbone
# and method), with its per-image rows, so that the scoring of every image can be
# checked (results.json duplicates results.csv and stays untracked). The earlier
# 100/50-image seeded runs are kept because prefill_500.py extends them.
!results/revision_grid_500/
!results/revision_grid_500/results.csv
results/revision_grid_500_shards/
!results/revision_grid_seeded/
!results/revision_grid_seeded_attnlrp/
!results/revision_grid_seeded_50/
!results/revision_grid_seeded*/results.csv
